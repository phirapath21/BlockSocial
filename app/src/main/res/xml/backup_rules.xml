<?xml version="1.0" encoding="utf-8"?>
<!-- Auto Backup (Android 11 and below). The Nostr account file holds an encrypted
     private key whose Keystore key never leaves the device, so it is never backed up. -->
<full-backup-content>
    <exclude domain="sharedpref" path="nostr_account.xml" />
    <exclude domain="sharedpref" path="nostr_drafts.xml" />
    <exclude domain="sharedpref" path="nostr_accounts.xml" />
    <exclude domain="database" path="nostr_events.db" />
    <exclude domain="database" path="nostr_events.db-wal" />
    <exclude domain="database" path="nostr_events.db-shm" />
</full-backup-content>
